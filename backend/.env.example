PORT=4000
FRONTEND_URL=http://localhost:5173

# Base de datos (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=publitours
DB_USER=publitours_app
DB_PASSWORD=cambia_esta_contraseña

# Autenticación (genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=cambia_este_secreto
JWT_EXPIRES_IN=8h

# Correo para recuperación de contraseña (Gmail + contraseña de aplicación). Vacío = modo desarrollo (código en consola)
EMAIL_USER=
EMAIL_PASS=

# IA (Claude) para entender solicitudes de viaje en lenguaje natural. Vacío = interpretación básica por reglas.
# Crea una clave en https://console.anthropic.com y pégala aquí (nunca la compartas ni la subas al repositorio).
ANTHROPIC_API_KEY=
# IA_MODELO=claude-haiku-4-5
# IA_LIMITE_POR_HORA=20

# Comisión estimada de la plataforma sobre cada reserva aceptada, en % (0 a 50). Hoy solo se muestra como estimación: no se cobra.
# COMISION_PORCENTAJE=10

# --- Operación (producción) ---
# NODE_ENV=production activa las validaciones estrictas de arranque (secretos largos, CORS y correo obligatorios).
# CORS_ORIGIN=https://publitours.midominio.com    # origen(es) del frontend, separados por coma. En desarrollo no hace falta.
# TRUST_PROXY=1                                    # cuántos proxies (nginx, balanceador) hay delante; necesario para ver la IP real
# LIMITE_PETICIONES=600                            # peticiones por IP cada 15 min a toda la API
# LIMITE_INTENTOS_AUTH=30                          # intentos por IP cada 15 min de inicio de sesión, registro y recuperación
