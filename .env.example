# Variables para desplegar con Docker (docker compose up -d --build).
# Copia este archivo a .env y completa los valores. NUNCA subas el .env al repositorio.

# Base de datos (PostgreSQL dentro de Docker). Elige una contraseña larga: no es la de tu equipo local.
DB_NAME=publitours
DB_USER=publitours_app
DB_PASSWORD=

# Firma de las sesiones. Genera una con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Dirección pública desde la que se abre la aplicación (con http:// o https://), sin barra final.
# Si la sirves en otro puerto o dominio, cámbiala aquí (p. ej. https://publitours.midominio.com).
CORS_ORIGIN=http://localhost:8080
PUERTO_WEB=8080

# Correo (Gmail + contraseña de aplicación). Obligatorio en producción: de él salen los códigos de verificación.
EMAIL_USER=
EMAIL_PASS=

# Opcional: IA (Claude) para entender solicitudes de viaje. Vacío = interpretación básica por reglas.
ANTHROPIC_API_KEY=

# Opcional: comisión estimada de la plataforma en % (0 a 50). Hoy solo se muestra como estimación.
COMISION_PORCENTAJE=10
